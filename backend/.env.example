# ─── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated list of trusted frontend origins (CORS + CSRF origin check)
CLIENT_URL=http://localhost:5173
# Serve the built frontend (frontend/dist) from this server so the whole store runs as ONE service.
# Recommended for free hosting (e.g. one Render web service). Build the frontend first.
SERVE_CLIENT=false
# Set to 1 when running behind a reverse proxy / load balancer (Render, Railway, Nginx)
TRUST_PROXY=0

# ─── Database ────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sipcraft?retryWrites=true&w=majority
# Development only: set to true to run against an in-memory MongoDB (data is lost on restart,
# the database is auto-seeded on boot). Never use in production.
USE_MEMORY_DB=false

# ─── JWT ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=sipcraft-api
JWT_AUDIENCE=sipcraft-web

# ─── Cookies ─────────────────────────────────────────────
# lax | strict | none   (use "none" only when the API and frontend are on different sites; requires HTTPS)
COOKIE_SAMESITE=strict
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ─── Passwords ───────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_EXPIRES_MINUTES=15

# ─── Razorpay ────────────────────────────────────────────
# Test-mode keys are free (Dashboard → Account & Settings → API Keys, Test Mode). No KYC needed for test mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Image uploads ───────────────────────────────────────
# Optional. Cloudinary free plan: https://cloudinary.com (no card required).
# If left empty, uploads are saved to backend/uploads on the API server (free, no account).
# Public origin of the API, used for local upload URLs when the frontend is on another domain
# (e.g. https://sipcraft-api.onrender.com). Leave empty when /uploads is proxied on the same domain.
PUBLIC_API_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sipcraft

# ─── Email (SMTP) ────────────────────────────────────────
# Free options: Gmail (smtp.gmail.com, port 465, SMTP_SECURE=true, use an App Password) or
# Brevo free tier (smtp-relay.brevo.com, port 587). If SMTP_HOST is empty, emails are logged to
# the console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Sipcraft <hello@sipcraft.in>"
# Where contact-form notifications are delivered
ADMIN_NOTIFY_EMAIL=

# ─── Store settings ──────────────────────────────────────
CURRENCY=INR
FREE_SHIPPING_THRESHOLD=999
SHIPPING_FEE=79
# GST rate applied to (subtotal - discount), as a percentage
TAX_RATE=18
# Minutes an unpaid order holds reserved stock before it is released
PAYMENT_HOLD_MINUTES=20

# ─── Seed ────────────────────────────────────────────────
ADMIN_NAME=Store Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Password for the 5 sample customers created by `npm run seed`
SEED_USER_PASSWORD=
