# Base URL of the API as seen by the browser.
# Development: leave as /api (Vite proxies it to VITE_DEV_API_TARGET).
# Production: /api when the API is served behind the same domain, or the full API URL, e.g. https://api.sipcraft.in/api
VITE_API_URL=/api

# Development proxy target for /api
VITE_DEV_API_TARGET=http://localhost:5000

# Public site URL, used for canonical links and Open Graph tags
VITE_SITE_URL=http://localhost:5173

# Only VITE_* variables are exposed to the browser. Never put secrets here.
